# Copy to infra/litellm/.env
LITELLM_MASTER_KEY=sk-change-me

# Ollama Cloud
OLLAMA_API_URL=https://ollama.com
OLLAMA_API_KEY=

# Postgres (separate `litellm` DB) — required for the admin UI
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/litellm
STORE_MODEL_IN_DB=True

# Admin UI login at http://localhost:4000/ui
UI_USERNAME=admin
UI_PASSWORD=change-me
